        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/source/a/capabilities",
        "body": {
          "fields": [
            "title",
            "summary"
          ],
          "operators": [
            "contains"
          ],
          "supportsOr": false,
          "limit": 10,
          "nextSupported": true
        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/source/a/search",
        "body": {
          "items": [
            {
              "id": "1",
